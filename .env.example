# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Gerar SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=troque-por-um-valor-aleatorio-de-32-bytes
DATABASE_URL=postgresql+psycopg://cupcakes:cupcakes@db:5432/cupcakes
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]

# false em desenvolvimento: o navegador DESCARTA cookie Secure sobre HTTP
# e o login falharia em silencio. true obrigatoriamente em producao.
COOKIE_SECURE=false

# Sem sistema de perfis. E-mails autorizados a usar a area da loja
# (/loja/pedidos no front, /api/v1/admin/... na API).
# Cadastre este e-mail na aplicacao para demonstrar o fluxo administrativo.
ADMIN_EMAILS=["admin@cupcakes.local"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
